function criarIconesBlobs_() {
  const blobs = {};
  Object.keys(ICONES_BASE64_PNG).forEach(function(nome) {
    blobs[nome] = Utilities.newBlob(Utilities.base64Decode(ICONES_BASE64_PNG[nome]), 'image/png', nome + '.png');
  });
  return blobs;
}

function enviarTesteIconesPNG() {
  const html = montarHtmlIconesPNG(DADOS_ICONES_PNG);
  GmailApp.sendEmail(EMAIL_DESTINO_ICONES_PNG, 'Teste - Template B (ícones PNG finais)', 'Abra este e-mail num cliente que suporte HTML pra ver o conteúdo completo.', {
    htmlBody: html,
    inlineImages: criarIconesBlobs_(),
    name: 'Essência do Brasil',
  });
  Logger.log('Enviado para ' + EMAIL_DESTINO_ICONES_PNG);
}

