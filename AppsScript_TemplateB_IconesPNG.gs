  const img = function(nomeIcone, tamanho) {
    return '<img src="cid:' + nomeIcone + '" width="' + tamanho + '" height="' + tamanho + '" alt="" style="display:inline-block;width:' + tamanho + 'px;height:' + tamanho + 'px;border:0;vertical-align:middle;">';
