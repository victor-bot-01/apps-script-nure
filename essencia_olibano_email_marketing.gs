function getInlineImagesOlibano_() {
  return {
    heroBanner: blobFromBase64_('', 'image/jpeg', 'hero-olibano.jpg'),
    storyBanner: blobFromBase64_('', 'image/jpeg', 'story-olibano.jpg'),
    perfumeProduct: blobFromBase64_('', 'image/jpeg', 'perfume-olibano.jpg'),
    oleoProduct: blobFromBase64_('', 'image/jpeg', 'oleo-olibano.jpg'),
    iconLeaf: blobFromBase64_('', 'image/png', 'icon-leaf.png'),
    iconExtract: blobFromBase64_('', 'image/png', 'icon-extract.png'),
    iconOrigin: blobFromBase64_('', 'image/png', 'icon-origin.png'),
    iconBottle: blobFromBase64_('', 'image/png', 'icon-bottle.png')
  };
}

function blobFromBase64_(base64Data, mimeType, fileName) {
  return Utilities.newBlob(
    Utilities.base64Decode(base64Data),
    mimeType,
    fileName
  );
}
