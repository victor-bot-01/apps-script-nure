/**
 * Essência do Brasil — Campanha Olíbano
 * Template de e-mail marketing em GmailApp.sendEmail
 *
 * COMO USAR
 * 1) Cole este arquivo em um projeto do Google Apps Script.
 * 2) Execute enviarTesteOlibano().
 * 3) Na primeira execução, autorize o acesso ao Gmail.
 * 4) O teste será enviado para a conta que estiver executando o script.
 *
 * Para enviar manualmente para outro endereço, use:
 * enviarOlibanoPara('email@dominio.com');
 */

function enviarTesteOlibano() {
  var destinatario = Session.getEffectiveUser().getEmail();

  if (!destinatario) {
    throw new Error(
      'Não foi possível identificar automaticamente o e-mail da conta. ' +
      "Execute enviarOlibanoPara('seuemail@dominio.com')."
    );
  }

  enviarOlibanoPara(destinatario);
}

function enviarOlibanoPara(destinatario) {
  if (!destinatario || destinatario.indexOf('@') === -1) {
    throw new Error('Informe um e-mail válido em enviarOlibanoPara().');
  }

  var cfg = getConfigOlibano_();
  var inlineImages = getInlineImagesOlibano_();
  var html = buildHtmlOlibano_(cfg);

  GmailApp.sendEmail(
    destinatario,
    cfg.assunto,
    'Seu cliente de e-mail não suporta HTML. Acesse https://essenciadobrasil.com.br/',
    {
      name: 'Essência do Brasil',
      htmlBody: html,
      inlineImages: inlineImages
    }
  );

  Logger.log('E-mail enviado para: ' + destinatario);
}

