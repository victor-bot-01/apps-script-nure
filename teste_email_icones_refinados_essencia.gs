function beneficio_(icone, linha1, linha2, separador) {
  return `
    <td width="25%" valign="middle" style="padding:15px 9px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td width="38" valign="middle" style="padding-right:8px;">
            <img src="cid:${icone}" width="31" alt="" style="display:block; width:31px; height:auto; border:0;">
          </td>
          <td valign="middle" style="font-family:Arial,Helvetica,sans-serif; font-size:10px; line-height:14px; font-weight:700; letter-spacing:.45px; color:#f4efe5; ${separador ? 'border-right:1px solid #657061; padding-right:9px;' : ''}">
            ${linha1}<br>${linha2}
          </td>
        </tr>
      </table>
    </td>`;
}

function nota_(texto, icone) {
  return `
