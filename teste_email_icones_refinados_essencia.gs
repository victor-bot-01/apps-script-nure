      <div style="font-size:8px; line-height:11px; min-height:34px;">${texto}</div>
      <img src="cid:${icone}" width="20" alt="" style="display:block; width:20px; height:auto; margin:5px auto 0 auto; border:0;">
    </td>`;
}

function infoPromo_(icone, titulo, texto) {
  return `
