function enviarTesteEmailLuxo() {
  const email = EMAIL_DESTINO || Session.getActiveUser().getEmail();

  if (!email) {
    throw new Error(
      'Não foi possível identificar seu e-mail. Preencha EMAIL_DESTINO no início do código.'
    );
  }

  const inlineImages = {};
  Object.keys(ICON_BASE64).forEach(function(nome) {
    inlineImages[nome] = Utilities.newBlob(
      Utilities.base64Decode(ICON_BASE64[nome]),
      'image/png',
      nome + '.png'
    );
  });

  GmailApp.sendEmail(
    email,
    'Teste visual — ícones refinados Essência do Brasil',
    'Seu cliente de e-mail não exibiu a versão HTML.',
    {
      htmlBody: gerarHtmlEmail_(),
      inlineImages: inlineImages,
      name: 'Essência do Brasil'
    }
  );

  Logger.log('Teste enviado para: ' + email);
}

