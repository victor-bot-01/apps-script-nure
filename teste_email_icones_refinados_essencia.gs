      <tr>
        <td width="34" valign="middle" style="padding-right:9px;"><img src="cid:${icone}" width="29" alt="" style="display:block; width:29px; height:auto; border:0;"></td>
        <td valign="middle" style="font-family:Arial,Helvetica,sans-serif; color:#f4efe5;">
          <div style="font-size:10px; line-height:14px; font-weight:700; color:#d2aa61;">${titulo}</div>
          <div style="font-size:9px; line-height:13px;">${texto}</div>
        </td>
      </tr>
    </table>`;
}

function social_(icone) {
  return `<td style="padding:0 8px;"><img src="cid:${icone}" width="20" alt="" style="display:block; width:20px; height:auto; border:0;"></td>`;
}
