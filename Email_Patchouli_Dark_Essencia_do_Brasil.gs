function blobFromBase64_(base64, filename) {
  return Utilities.newBlob(Utilities.base64Decode(base64), 'image/png', filename);
}

function criarInlineImagesPatchouliDark_() {
  return {
    brandmark: blobFromBase64_(BRANDMARK_B64, 'brandmark.png'),
    leafIcon: blobFromBase64_(LEAF_ICON_B64, 'leaf-icon.png'),
    globeIcon: blobFromBase64_(GLOBE_ICON_B64, 'globe-icon.png'),
    careIcon: blobFromBase64_(CARE_ICON_B64, 'care-icon.png'),
    packageIcon: blobFromBase64_(PACKAGE_ICON_B64, 'package-icon.png'),
    heroBanner: blobFromBase64_(HERO_BANNER_B64, 'hero-banner.png'),
    perfumeProduct: blobFromBase64_(PERFUME_PRODUCT_B64, 'perfume-product.png'),
    storyBanner: blobFromBase64_(STORY_BANNER_B64, 'story-banner.png')
  };
}

