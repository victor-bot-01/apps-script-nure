function extrairCidsDoHtml_(html) {
  const matches = [...html.matchAll(/cid:([A-Za-z0-9_-]+)/g)].map(function(m) { return m[1]; });
  return Array.from(new Set(matches)).sort();
}

function encontrarTdResponsivaComWidth_(html) {
  const tdTags = html.match(/<td\b[^>]*>/gi) || [];
  const responsiveClassRegex = /class="[^"]*(stack100|benefit-cell|footer-col|section-pad|hero-pad|story-copy)[^"]*"/i;
  return tdTags.filter(function(tag) {
    return responsiveClassRegex.test(tag) && /\bwidth\s*=\s*['"][^'"]+['"]/i.test(tag);
  });
}

function validarTemplatePatchouliDark_() {
  const html = criarHtmlEmailPatchouliDark_();
  const inlineImages = criarInlineImagesPatchouliDark_();
  const cids = extrairCidsDoHtml_(html);
  const inlineKeys = Object.keys(inlineImages).sort();
  const missingInline = cids.filter(function(cid) { return inlineKeys.indexOf(cid) === -1; });
  const missingHtml = inlineKeys.filter(function(key) { return cids.indexOf(key) === -1; });

  if (missingInline.length || missingHtml.length) {
    throw new Error(
      'Falha na regra 19. CIDs e chaves de inlineImages não batem. ' +
      'Sem inlineImage para: [' + missingInline.join(', ') + ']. ' +
      'Sobrando em inlineImages: [' + missingHtml.join(', ') + '].'
    );
  }

  const offenders = encontrarTdResponsivaComWidth_(html);
  if (offenders.length) {
    throw new Error('Falha na regra 21. Encontradas <td> responsivas com atributo width=: ' + offenders.join(' | '));
  }

  return { ok: true, cids: cids, inlineKeys: inlineKeys, subject: SUBJECT_PATCHOULI_DARK };
}

