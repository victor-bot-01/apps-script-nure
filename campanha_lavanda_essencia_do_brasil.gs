function enviarTesteCampanhaLavanda() {
  var destinatario = Session.getActiveUser().getEmail();
  var assunto = 'Lavanda para desacelerar o dia com elegância';
  var links = getLinksCampanhaLavanda_();
  var inlineImages = getInlineImagesCampanhaLavanda_();
  var htmlBody = montarHtmlCampanhaLavanda_(links);
  var plainBody = montarTextoCampanhaLavanda_(links);

  GmailApp.sendEmail(destinatario, assunto, plainBody, {
    htmlBody: htmlBody,
    inlineImages: inlineImages,
    name: 'Essência do Brasil'
  });
}

function getLinksCampanhaLavanda_() {
  return {
    home: 'https://essenciadobrasil.com.br/',
    perfumesFemininos: 'https://essenciadobrasil.com.br/perfumes-femininos/',
    oleosEssenciais: 'https://essenciadobrasil.com.br/oleos-essenciais/',
    oleosVegetais: 'https://essenciadobrasil.com.br/oleos-vegetais/',
    essencias: 'https://essenciadobrasil.com.br/essencias/',
    serunsECremes: 'https://essenciadobrasil.com.br/seruns-e-cremes/',
    produtoOleoLavanda: 'https://essenciadobrasil.com.br/produtos/oleo-essencial-lavanda-10ml-aromaterapia-natural-e-puro/',
    produtoPerfumeLavanda: 'https://essenciadobrasil.com.br/produtos/perfume-lavanda-da-franca-feminino-100ml-natural-e-vegano/'
  };
}

function getInlineImagesCampanhaLavanda_() {
  return {
    heroLavanda: blobBase64_('', 'image/jpeg', 'hero-lavanda.jpg'),
    perfumeLavanda: blobBase64_('', 'image/jpeg', 'perfume-lavanda.jpg'),
    bannerFinalLavanda: blobBase64_('', 'image/jpeg', 'banner-final-lavanda.jpg'),
    iconLeaf: blobBase64_('', 'image/png', 'icon-leaf.png'),
    iconDrop: blobBase64_('', 'image/png', 'icon-drop.png'),
    iconBox: blobBase64_('', 'image/png', 'icon-box.png'),
    iconTruck: blobBase64_('', 'image/png', 'icon-truck.png')
  };
}

function blobBase64_(base64String, mimeType, fileName) {
  return Utilities.newBlob(Utilities.base64Decode(base64String), mimeType, fileName);
}

function montarTextoCampanhaLavanda_(links) {
  return [
    'Essência do Brasil',
    '',
    'Do cuidado essencial ao perfume, descubra duas formas de viver a serenidade da lavanda.',
    '',
    'Óleo Essencial Lavanda 10ml — R$ 29,90',
    'Um aroma puro, delicado e envolvente para momentos de pausa, presença e bem-estar.',
    links.produtoOleoLavanda,
    '',
    'Perfume Lavanda da França Feminino 100ml — R$ 149,90',
    'Bergamota e limão siciliano na saída, lavanda no coração, vanilina e cedrol no fundo.',
    links.produtoPerfumeLavanda,
    '',
    'Categorias:',
    'Perfumes Femininos: ' + links.perfumesFemininos,
    'Óleos Essenciais: ' + links.oleosEssenciais,
    'Óleos Vegetais: ' + links.oleosVegetais,
    'Essências: ' + links.essencias,
    'Cremes e Séruns: ' + links.serunsECremes,
