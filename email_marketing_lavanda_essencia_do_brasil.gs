function enviarTesteLavanda() {
  const destinatario = Session.getEffectiveUser().getEmail();

  if (!destinatario) {
    throw new Error('Não foi possível identificar o e-mail da conta. Informe um destinatário manualmente em enviarEmailLavanda_(...).');
  }

  enviarEmailLavanda_(destinatario);
}

function enviarEmailLavanda_(destinatario) {
  const assunto = 'Lavanda: da flor ao frasco | Essência do Brasil';
  const assets = montarAssetsLavanda_();
  const html = montarHtmlLavanda_();

  const textoPlano =
    'Lavanda, quando a natureza pede silêncio.\n\n' +
    'Óleo Essencial Lavanda 10ml — R$ 29,90\n' +
    'Lavandula angustifolia, origem França, extração por destilação a vapor das flores.\n' +
    'Conheça: ' + URL_OLEO + '\n\n' +
    'Lavanda da França Masculino 100ml — Botânica Imperial.\n' +
    'Conheça: ' + URL_PERFUME + '\n\n' +
    'Essência do Brasil — ' + URL_SITE;

  GmailApp.sendEmail(destinatario, assunto, textoPlano, {
    htmlBody: html,
    inlineImages: assets,
    name: 'Essência do Brasil'
  });
}

