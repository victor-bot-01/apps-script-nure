function validarTemplateMemoriaOlfativa_() {
  const html = montarHtmlMemoriaOlfativa_();
  const inlineImages = getInlineImagesMemoria_();

  if (!html.includes(`max-width:${MEMORIA_OLFATIVA.maxWidth}px`)) throw new Error('Tabela principal sem max-width esperado.');
  if (!html.includes(`max-width:${MEMORIA_OLFATIVA.breakpoint}px`)) throw new Error('Breakpoint não segue max-width + 20px.');
  if (!html.includes(MEMORIA_OLFATIVA.heroDesktop) || !html.includes(MEMORIA_OLFATIVA.heroMobile)) throw new Error('As duas versões do hero precisam estar presentes.');
  if (!html.includes('.banner-desktop{display:none!important') || !html.includes('.banner-mobile{display:block!important')) throw new Error('Alternância mobile dos banners ausente.');
  if (/attachments\s*:/.test(html)) throw new Error('Não deve haver attachments.');

  // Regra 21: qualquer td com classe que muda width/display no mobile não pode ter atributo HTML width=.
  const responsiveClasses = ['stack100','benefit-cell','footer-col'];
  responsiveClasses.forEach(cls => {
    const re = new RegExp(`<td[^>]*class=["'][^"']*\\b${cls}\\b[^"']*["'][^>]*\\swidth=`, 'i');
    if (re.test(html)) throw new Error('Regra 21 violada em <td> com classe ' + cls + '.');
  });

  // Regra 19: lista de inlineImages e cids deve ser idêntica 1:1.
  const cidMatches = [...html.matchAll(/cid:([A-Za-z0-9_-]+)/g)].map(m => m[1]);
  const cids = [...new Set(cidMatches)].sort();
  const keys = Object.keys(inlineImages).sort();
  if (JSON.stringify(cids) !== JSON.stringify(keys)) {
    throw new Error('Regra 19 violada. CIDs HTML=' + cids.join(',') + ' | inlineImages=' + keys.join(','));
  }

  // Fotos/banners nunca via cid.
  if (/cid:(hero|banner|produto|foto)/i.test(html)) throw new Error('Regra 23 violada: foto/banner não pode usar cid.');

  // Descadastro literal.
  const compliance = 'Você recebeu este e-mail porque está em nossa lista de relacionamento. Para solicitar o descadastramento, responda a esta mensagem com o assunto DESCADASTRAR.';
  if (!html.includes(compliance)) throw new Error('Texto obrigatório de descadastro foi alterado.');

  return true;
}

function enviarTesteMemoriaOlfativa() {
  validarTemplateMemoriaOlfativa_();
  const destinatario = Session.getActiveUser().getEmail();
  if (!destinatario) throw new Error('Não foi possível obter o e-mail do usuário ativo via Session.getActiveUser().getEmail().');

  GmailApp.sendEmail(
    destinatario,
    MEMORIA_OLFATIVA.subject,
    'Este e-mail possui uma versão HTML. Abra-o em um cliente compatível com HTML.',
    {
      htmlBody: montarHtmlMemoriaOlfativa_(),
      inlineImages: getInlineImagesMemoria_(),
      name: 'Essência do Brasil'
    }
  );
}
