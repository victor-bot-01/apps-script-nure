function getInlineImagesMemoria_() {
  // PNGs transparentes 30x30, simples e leves: livro=conhecimento; cérebro/memória; gota=aromas; fotografia=histórias.
  const b64 = {
    conhecimento: '', // 146 bytes
    memoria: '', // 212 bytes
    aromas: '', // 204 bytes
    historias: '', // 197 bytes
  };
  const out = {};
  Object.keys(b64).forEach(function(k) {
    out[k] = Utilities.newBlob(Utilities.base64Decode(b64[k]), 'image/png', 'icone_' + k + '.png');
  });
  return out;
}

