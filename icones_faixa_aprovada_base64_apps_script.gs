/**
 * ÍCONES INDIVIDUAIS — ESTILO DA FAIXA APROVADA
 *
 * Todos os ícones estão incorporados como base64 em PNG com fundo transparente.
 * Você pode:
 * 1) usar os blobs diretamente no seu HTML de e-mail;
 * 2) salvar os PNGs no Drive;
 * 3) extrair/copiar o base64 conforme preferir.
 */

function obterBlobsIconesFaixaAprovada() {
  const iconePerfume = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-perfume.png'
  );

  const iconeFolha = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-folha.png'
  );

  const iconeCrueltyVegano = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-cruelty-vegano.png'
  );

  const iconePresente = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-presente.png'
  );

  return {
    iconePerfume: iconePerfume,
    iconeFolha: iconeFolha,
    iconeCrueltyVegano: iconeCrueltyVegano,
    iconePresente: iconePresente
  };
}

/**
 * Opcional: salva os 4 ícones como arquivos PNG no seu Google Drive.
 */
function salvarIconesNoDrive() {
  const icones = obterBlobsIconesFaixaAprovada();

  DriveApp.createFile(icones.iconePerfume);
  DriveApp.createFile(icones.iconeFolha);
  DriveApp.createFile(icones.iconeCrueltyVegano);
  DriveApp.createFile(icones.iconePresente);

  Logger.log('Ícones salvos no Drive com sucesso.');
}

/**
 * Opcional: envia um e-mail de teste mostrando os 4 ícones individualmente.
 */
function enviarTesteIconesIndividuais() {
  const email = Session.getActiveUser().getEmail();
  if (!email) {
    throw new Error('Não foi possível detectar o e-mail da conta ativa.');
  }

  const icones = obterBlobsIconesFaixaAprovada();

  const html = `
  <div style="background:#ffffff;padding:24px;">
    <table role="presentation" cellspacing="0" cellpadding="18" border="0" style="border-collapse:collapse;">
      <tr>
        <td align="center"><img src="cid:perfume" width="128" style="display:block;border:0;width:128px;height:auto;"></td>
        <td align="center"><img src="cid:folha" width="128" style="display:block;border:0;width:128px;height:auto;"></td>
      </tr>
      <tr>
        <td align="center"><img src="cid:cruelty" width="128" style="display:block;border:0;width:128px;height:auto;"></td>
        <td align="center"><img src="cid:presente" width="128" style="display:block;border:0;width:128px;height:auto;"></td>
      </tr>
    </table>
  </div>`;

  GmailApp.sendEmail(
    email,
    'Teste — ícones individuais',
    'Abra em um cliente que suporte HTML.',
    {
      htmlBody: html,
      inlineImages: {
        perfume: icones.iconePerfume,
        folha: icones.iconeFolha,
        cruelty: icones.iconeCrueltyVegano,
        presente: icones.iconePresente
      }
    }
  );

  Logger.log('E-mail de teste enviado para: ' + email);
}
