}

function enviarTesteDiaDoCerrado() {
  validarTemplateDiaDoCerrado();

  var t = templateDiaDoCerrado_();
  var destinatario = Session.getActiveUser().getEmail();

  if (!destinatario) {
    throw new Error('Não foi possível obter o e-mail do usuário ativo.');
  }

  GmailApp.sendEmail(
    destinatario,
    t.subject,
    'Abra este e-mail em um cliente compatível com HTML.',
    {
      htmlBody: t.html,
      inlineImages: t.inlineImages,
      name: 'Essência do Brasil'
    }
  );
}

function validarTemplateDiaDoCerrado() {
  var t = templateDiaDoCerrado_();

  var keys = Object.keys(t.inlineImages).sort();
  var matches = t.html.match(/cid:([A-Za-z0-9_-]+)/g) || [];
  var cids = matches
    .map(function(x) { return x.substring(4); })
    .filter(function(v, i, a) { return a.indexOf(v) === i; })
    .sort();

  if (JSON.stringify(keys) !== JSON.stringify(cids)) {
    throw new Error('inlineImages e cid: não batem 1:1.');
  }

  if (t.html.indexOf('attachments') !== -1) {
    throw new Error('attachments não permitido.');
  }

  if (t.html.indexOf('max-width:900px') === -1) {
    throw new Error('Container máximo de 900px ausente.');
  }

  if (t.html.indexOf('max-width:920px') === -1) {
    throw new Error('Breakpoint de 920px ausente.');
  }

  var botanicos = ["https://i.ibb.co/QjP315jG/copaiba-card-220.jpg", "https://i.ibb.co/6JyB1hXN/alecrim-card-220.jpg", "https://i.ibb.co/TMFv4cyT/capim-limao-card-220.jpg", "https://i.ibb.co/Z6j9fLjN/laranja-doce-card-220.jpg", "https://i.ibb.co/q3wBFd4d/lavanda-card-220.jpg"];
  botanicos.forEach(function(url) {
    if (t.html.indexOf(url) === -1) {
      throw new Error('Imagem botânica pública ausente: ' + url);
    }
  });

  var unsubscribe = 'Você recebeu este e-mail porque está em nossa lista de relacionamento. Para solicitar o descadastramento, responda a esta mensagem com o assunto DESCADASTRAR.';
  if (t.html.indexOf(unsubscribe) === -1) {
    throw new Error('Texto de descadastramento alterado ou ausente.');
  }

  if (t.subject !== 'E se as plantas contassem sua história através dos aromas?') {
    throw new Error('Assunto do e-mail foi alterado.');
  }

  return true;
}
