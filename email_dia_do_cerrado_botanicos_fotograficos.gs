  var ICONS_B64 = {"biodiversidade": "", "quimica": "", "funcao": "", "preservacao": "", "aromas": "", "sabia": "", "footer_biodiversidade": "", "footer_plantas": "", "footer_oleos": "", "footer_preservacao": ""};
