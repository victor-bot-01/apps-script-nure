/**
 * ÍCONES DO BLOCO DE BENEFÍCIOS / SERVIÇOS
 *
 * PNGs individuais com fundo transparente, em base64, no padrão:
 * Utilities.newBlob(Utilities.base64Decode('...'), 'image/png', 'nome.png')
 *
 * Ícones incluídos:
 * - presente
 * - frete / caminhão
 * - cartão
 * - seguro / escudo com cadeado
 */

function obterBlobsIconesBeneficiosServico() {
  const iconePresente = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-presente.png'
  );

  const iconeFrete = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-frete.png'
  );

  const iconeCartao = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-cartao.png'
  );

  const iconeSeguro = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-seguro.png'
  );

  return {
    iconePresente: iconePresente,
    iconeFrete: iconeFrete,
    iconeCartao: iconeCartao,
    iconeSeguro: iconeSeguro
  };
}

/**
 * Opcional: salva os 4 ícones no Google Drive.
 */
function salvarIconesBeneficiosServicoNoDrive() {
  const icones = obterBlobsIconesBeneficiosServico();

  DriveApp.createFile(icones.iconePresente);
  DriveApp.createFile(icones.iconeFrete);
  DriveApp.createFile(icones.iconeCartao);
  DriveApp.createFile(icones.iconeSeguro);

  Logger.log('Ícones salvos no Drive com sucesso.');
}

/**
 * Opcional: envia um e-mail de teste mostrando os 4 ícones separadamente.
 */
function enviarTesteIconesBeneficiosServico() {
  const email = Session.getActiveUser().getEmail();
  if (!email) {
    throw new Error('Não foi possível detectar o e-mail da conta ativa.');
  }

  const icones = obterBlobsIconesBeneficiosServico();

  const html = `
  <div style="background:#ffffff;padding:24px;">
    <table role="presentation" cellspacing="0" cellpadding="18" border="0" style="border-collapse:collapse;">
      <tr>
        <td align="center"><img src="cid:presente" width="112" style="display:block;border:0;width:112px;height:auto;"></td>
        <td align="center"><img src="cid:frete" width="112" style="display:block;border:0;width:112px;height:auto;"></td>
      </tr>
      <tr>
        <td align="center"><img src="cid:cartao" width="112" style="display:block;border:0;width:112px;height:auto;"></td>
        <td align="center"><img src="cid:seguro" width="112" style="display:block;border:0;width:112px;height:auto;"></td>
      </tr>
    </table>
  </div>`;

  GmailApp.sendEmail(
    email,
    'Teste — ícones benefícios/serviços',
    'Abra em um cliente que suporte HTML.',
    {
      htmlBody: html,
      inlineImages: {
        presente: icones.iconePresente,
        frete: icones.iconeFrete,
        cartao: icones.iconeCartao,
        seguro: icones.iconeSeguro
      }
    }
  );

  Logger.log('E-mail de teste enviado para: ' + email);
}
