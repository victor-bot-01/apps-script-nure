/**
 * ÍCONES DAS NOTAS — ESTILO DA FAIXA APROVADA
 *
 * PNGs individuais com fundo transparente, em base64, no mesmo padrão
 * dos ícones já aprovados anteriormente.
 */

function obterBlobsIconesNotas() {
  const iconeNotaFolha = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-nota-folha.png'
  );

  const iconeNotaOndas = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-nota-ondas.png'
  );

  const iconeNotaFlor = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-nota-flor.png'
  );

  const iconeNotaLua = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-nota-lua.png'
  );

  const iconeNotaArvore = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-nota-arvore.png'
  );

  const iconeNotaBrilho = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-nota-brilho.png'
  );

  return {
    iconeNotaFolha: iconeNotaFolha,
    iconeNotaOndas: iconeNotaOndas,
    iconeNotaFlor: iconeNotaFlor,
    iconeNotaLua: iconeNotaLua,
    iconeNotaArvore: iconeNotaArvore,
    iconeNotaBrilho: iconeNotaBrilho
  };
}

/**
 * Opcional: salva os 6 ícones das notas no Google Drive.
 */
function salvarIconesNotasNoDrive() {
  const icones = obterBlobsIconesNotas();

  DriveApp.createFile(icones.iconeNotaFolha);
  DriveApp.createFile(icones.iconeNotaOndas);
  DriveApp.createFile(icones.iconeNotaFlor);
  DriveApp.createFile(icones.iconeNotaLua);
  DriveApp.createFile(icones.iconeNotaArvore);
  DriveApp.createFile(icones.iconeNotaBrilho);

  Logger.log('Ícones das notas salvos no Drive com sucesso.');
}

/**
 * Opcional: envia um e-mail de teste mostrando os 6 ícones separadamente.
 */
function enviarTesteIconesNotas() {
  const email = Session.getActiveUser().getEmail();
  if (!email) {
    throw new Error('Não foi possível detectar o e-mail da conta ativa.');
  }

  const icones = obterBlobsIconesNotas();

  const html = `
  <div style="background:#ffffff;padding:24px;">
    <table role="presentation" cellspacing="0" cellpadding="18" border="0" style="border-collapse:collapse;">
      <tr>
        <td align="center"><img src="cid:folha" width="96" style="display:block;border:0;width:96px;height:auto;"></td>
        <td align="center"><img src="cid:ondas" width="96" style="display:block;border:0;width:96px;height:auto;"></td>
        <td align="center"><img src="cid:flor" width="96" style="display:block;border:0;width:96px;height:auto;"></td>
      </tr>
      <tr>
        <td align="center"><img src="cid:lua" width="96" style="display:block;border:0;width:96px;height:auto;"></td>
        <td align="center"><img src="cid:arvore" width="96" style="display:block;border:0;width:96px;height:auto;"></td>
        <td align="center"><img src="cid:brilho" width="96" style="display:block;border:0;width:96px;height:auto;"></td>
      </tr>
    </table>
  </div>`;

  GmailApp.sendEmail(
    email,
    'Teste — ícones das notas',
    'Abra em um cliente que suporte HTML.',
    {
      htmlBody: html,
      inlineImages: {
        folha: icones.iconeNotaFolha,
        ondas: icones.iconeNotaOndas,
        flor: icones.iconeNotaFlor,
        lua: icones.iconeNotaLua,
        arvore: icones.iconeNotaArvore,
        brilho: icones.iconeNotaBrilho
      }
    }
  );

  Logger.log('E-mail de teste enviado para: ' + email);
}
