/**
 * FAIXA DE BENEFÍCIOS — IMAGEM APROVADA
 *
 * Este código envia exatamente a imagem aprovada no chat.
 * O desenho não é recriado por HTML/CSS: o próprio PNG é incorporado no e-mail.
 */

const EMAIL_DESTINO = ''; // Ex.: 'seuemail@gmail.com'

function enviarTesteFaixaBeneficios() {
  const email = EMAIL_DESTINO || Session.getActiveUser().getEmail();

  if (!email) {
    throw new Error(
      'Preencha EMAIL_DESTINO no início do código com o e-mail de destino.'
    );
  }

  const faixa = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'faixa-beneficios-essencia.png'
  );

  const html = `
  <div style="margin:0; padding:0; background:#ffffff;">
    <table role="presentation"
           width="100%"
           cellspacing="0"
           cellpadding="0"
           border="0"
           style="margin:0; padding:0; border-collapse:collapse; background:#ffffff;">
      <tr>
        <td align="center" style="margin:0; padding:0;">
          <img
            src="cid:faixaBeneficios"
            width="600"
            alt="Alta fixação e longa duração. Fragrâncias exclusivas. Cruelty free e vegano. Perfeitos para presentear."
            style="
              display:block;
              width:100%;
              max-width:600px;
              height:auto;
              margin:0 auto;
              padding:0;
              border:0;
              outline:none;
              text-decoration:none;
            "
          >
        </td>
      </tr>
    </table>
  </div>`;

  GmailApp.sendEmail(
    email,
    'Teste — faixa de benefícios aprovada',
    'Abra este e-mail em um cliente com suporte a HTML.',
    {
      htmlBody: html,
      inlineImages: {
        faixaBeneficios: faixa
      },
      name: 'Essência do Brasil'
    }
  );

  Logger.log('E-mail enviado para: ' + email);
}
