function validarTemplateSetembroAmarelo_() {
  var html = setembroAmareloHtml_();
  var inlineImages = setembroAmareloInlineImages_();
  var erros = [];

  // Validação 1: todos os cid do HTML precisam existir em inlineImages.
  var encontrados = html.match(/cid:([A-Za-z0-9_-]+)/g) || [];
  var cids = encontrados.map(function(v) { return v.substring(4); })
    .filter(function(v, i, a) { return a.indexOf(v) === i; })
    .sort();

  var keys = Object.keys(inlineImages).sort();

  if (JSON.stringify(cids) !== JSON.stringify(keys)) {
    erros.push(
      'Os cid usados no HTML não correspondem exatamente às chaves de inlineImages. ' +
      'HTML=[' + cids.join(', ') + '] inlineImages=[' + keys.join(', ') + ']'
    );
  }

  // Validação 2: não usar attachments.
  if (/attachments\s*:/.test(html)) {
    erros.push('Foi encontrada referência a attachments.');
  }

  // Validação 3: os quatro banners aprovados precisam estar presentes.
  var banners = [
    'https://i.ibb.co/Z6xqs1Gs/file-0000000094c4820ea9de5be9e45b2070.png',
    'https://i.ibb.co/SwY2QDfZ/file-00000000ccf8820ebb4db32fb90ea837.png',
    'https://i.ibb.co/nMNjrHRR/file-000000002d84820e8e2b59ca60135472.png',
    'https://i.ibb.co/GQhm0bGZ/file-0000000079d4820ebab29479eaae08cd.png'
  ];
  banners.forEach(function(url) {
    if (html.indexOf(url) === -1) {
      erros.push('Banner ausente do HTML: ' + url);
    }
  });

  // Validação 4: descadastro exato.
  var descadastro = 'Você recebeu este e-mail porque está em nossa lista de relacionamento. Para solicitar o descadastramento, responda a esta mensagem com o assunto DESCADASTRAR.';
  if (html.indexOf(descadastro) === -1) {
    erros.push('O texto obrigatório de descadastro não está exato.');
  }

  // Validação 5: pares desktop/mobile.
  if ((html.match(/class="banner-desktop"/g) || []).length !== 2) {
    erros.push('Esperados exatamente 2 banners desktop.');
  }
  if ((html.match(/class="banner-mobile"/g) || []).length !== 2) {
    erros.push('Esperados exatamente 2 banners mobile.');
  }

  if (erros.length) {
    throw new Error('Falha na validação do template:\n- ' + erros.join('\n- '));
  }

  return true;
}

function enviarTesteSetembroAmarelo() {
  validarTemplateSetembroAmarelo_();

  var destinatario = Session.getActiveUser().getEmail();
  if (!destinatario) {
    throw new Error('Não foi possível obter o e-mail do usuário ativo.');
  }

  GmailApp.sendEmail(
    destinatario,
    setembroAmareloConfig_().subject,
    'Setembro Amarelo — A vida é essencial. Abra esta mensagem em um cliente compatível com HTML.',
    {
      htmlBody: setembroAmareloHtml_(),
      inlineImages: setembroAmareloInlineImages_(),
      name: 'Essência do Brasil'
    }
  );
}
