function blobBase64_(key) {
  var meta = ASSET_META_[key];
  if (!meta || !ASSET_B64_[key]) {
    throw new Error('Asset inexistente: ' + key);
  }
  return Utilities.newBlob(
    Utilities.base64Decode(ASSET_B64_[key]),
    meta.mime,
    meta.name
  );
}

