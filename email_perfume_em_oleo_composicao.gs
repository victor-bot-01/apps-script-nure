function enviarTestePerfumeEmOleoComposicao() {
  const destinatario = Session.getActiveUser().getEmail();
  if (!destinatario) {
    throw new Error('Não foi possível identificar o e-mail da conta. Use enviarEmailPerfumeEmOleoComposicao("seu@email.com").');
  }
  enviarEmailPerfumeEmOleoComposicao(destinatario);
}

