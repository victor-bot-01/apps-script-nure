/**
 * Validação rápida do próprio arquivo antes do envio.
 * Não envia nada: apenas acusa violações estruturais mais fáceis de detectar.
 */
function validarTemplatePerfumeEmOleoComposicao() {
  var erros = [];
  if (HTML_COMPOSICAO.indexOf('max-width:900px') === -1) erros.push('Tabela principal sem max-width:900px.');
  if (HTML_COMPOSICAO.indexOf('max-width:920px') === -1) erros.push('Breakpoint precisa ser 920px.');
  if (HTML_COMPOSICAO.indexOf('table-layout:fixed') === -1) erros.push('table-layout:fixed ausente.');
  if (HTML_COMPOSICAO.indexOf('box-sizing:border-box!important') === -1) erros.push('box-sizing obrigatório ausente na media query.');
  if (HTML_COMPOSICAO.indexOf('max-width:100%') === -1) erros.push('max-width:100% ausente em imagens/classes responsivas.');
  if (HTML_COMPOSICAO.indexOf('Você recebeu este e-mail porque está em nossa lista de relacionamento. Para solicitar o descadastramento, responda a esta mensagem com o assunto DESCADASTRAR.') === -1) erros.push('Texto padrão de descadastro alterado ou ausente.');
  if (erros.length) throw new Error(erros.join('\n'));
  Logger.log('Template validado: nenhuma pendência estrutural detectada.');
}
