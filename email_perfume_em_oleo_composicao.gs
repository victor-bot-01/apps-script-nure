function validarTemplatePerfumeEmOleoComposicao() {
  var html = montarTemplatePerfumeEmOleoComposicao_();
  var inlineImages = obterInlineImagesPerfumeEmOleoComposicao_();
  var erros = [];

  // 1) Todas as tabelas precisam declarar width no HTML e no style.
  var tabelas = html.match(/<table\b[^>]*>/gi) || [];
  tabelas.forEach(function(tag, i) {
    if (!/\swidth\s*=\s*["'][^"']+["']/i.test(tag)) erros.push('Tabela ' + (i + 1) + ' sem atributo HTML width.');
    if (!/style\s*=\s*["'][^"']*\bwidth\s*:/i.test(tag)) erros.push('Tabela ' + (i + 1) + ' sem width no style inline.');
    var eh100 = /\swidth\s*=\s*["']100%["']/i.test(tag);
    var variavel = /class\s*=\s*["'][^"']*fluid-variable[^"']*["']/i.test(tag);
    if (eh100 && !variavel && !/table-layout\s*:\s*fixed/i.test(tag)) erros.push('Tabela width=100% sem table-layout:fixed: ' + tag.substring(0, 180));
    if (variavel && /table-layout\s*:\s*fixed/i.test(tag)) erros.push('Tabela fluid-variable não pode usar table-layout:fixed.');
  });

  // 2) Toda imagem precisa de width, height e max-width:100%.
  var imgs = html.match(/<img\b[^>]*>/gi) || [];
  imgs.forEach(function(tag, i) {
    if (!/\swidth\s*=\s*["'][^"']+["']/i.test(tag)) erros.push('Imagem ' + (i + 1) + ' sem width HTML.');
    if (!/\sheight\s*=\s*["'][^"']+["']/i.test(tag)) erros.push('Imagem ' + (i + 1) + ' sem height HTML.');
    if (!/max-width\s*:\s*100%/i.test(tag)) erros.push('Imagem ' + (i + 1) + ' sem max-width:100%.');
  });

  // 3) TDs que mudam de largura/display na media query não podem ter atributo HTML width.
  var classesMoveis = ['stack100','benefit-cell','footer-col','header-logo','header-trust','hero-copy','hero-art','story-blank','story-copy'];
  var tds = html.match(/<td\b[^>]*>/gi) || [];
  tds.forEach(function(tag) {
    var temClasseMovel = classesMoveis.some(function(classe) {
      var re = new RegExp('class\\s*=\\s*["\\\'][^"\\\']*\\b' + classe + '\\b[^"\\\']*["\\\']', 'i');
      return re.test(tag);
    });
    if (temClasseMovel && /\swidth\s*=/i.test(tag)) erros.push('TD responsivo com atributo HTML width proibido: ' + tag.substring(0, 180));
  });

  // 4) Breakpoint = 900 + 20 = 920px.
  if (html.indexOf('@media only screen and (max-width:920px)') === -1) erros.push('Breakpoint obrigatório de 920px não encontrado.');
  if (html.indexOf('max-width:900px') === -1) erros.push('max-width principal de 900px não encontrado.');

  // 5) Texto responsivo de hero/story: classes individuais e font-size/line-height mobile.
  ['hero-kicker','hero-title','hero-subline','hero-body','story-title','story-body'].forEach(function(classe) {
    if (html.indexOf('class="' + classe + '"') === -1) erros.push('Classe de texto responsivo ausente: ' + classe);
    var reCss = new RegExp('\\.' + classe + '\\{[^}]*font-size\\s*:[^;]+!important;[^}]*line-height\\s*:[^;]+!important;', 'i');
    if (!reCss.test(html)) erros.push('Ajuste mobile de font-size/line-height ausente para .' + classe);
  });

  // 6) Proíbe sequência de separadores que impeça quebra.
  if (/&nbsp;\s*•\s*&nbsp;/i.test(html)) erros.push('Uso proibido de &nbsp; ao redor de separador encontrado.');

  // 7) Compliance de descadastro exato.
  var descadastro = 'Você recebeu este e-mail porque está em nossa lista de relacionamento. Para solicitar o descadastramento, responda a esta mensagem com o assunto DESCADASTRAR.';
  if (html.indexOf(descadastro) === -1) erros.push('Texto exato de descadastro não encontrado.');

  // 8) Chaves inlineImages x cids usados: comparação 1 para 1, sem órfãos.
  var cids = {};
  var reCid = /cid:([A-Za-z0-9_-]+)/g;
  var m;
  while ((m = reCid.exec(html)) !== null) cids[m[1]] = true;
  var cidKeys = Object.keys(cids).sort();
  var imageKeys = Object.keys(inlineImages).sort();
  var faltamBlobs = cidKeys.filter(function(k) { return imageKeys.indexOf(k) === -1; });
  var orfaos = imageKeys.filter(function(k) { return cidKeys.indexOf(k) === -1; });
  if (faltamBlobs.length) erros.push('CID(s) sem inlineImage: ' + faltamBlobs.join(', '));
  if (orfaos.length) erros.push('inlineImage(s) órfã(s): ' + orfaos.join(', '));

  // 9) Confere as larguras percentuais fixas das grades principais.
  var seis = (html.match(/style="width:16\.66%;/g) || []).length;
  if (seis < 6) erros.push('Grade de 6 colunas não contém as seis larguras de 16.66%.');
  var quatro = (html.match(/class="benefit-cell"[^>]*style="width:25%;/g) || []).length;
  if (quatro !== 4) erros.push('Faixa de 4 benefícios deve ter quatro células de 25%.');

  // 10) Links essenciais reais/confirmados.
  Object.keys(URLS_COMPOSICAO_).forEach(function(k) {
    var url = URLS_COMPOSICAO_[k];
    if (!/^https:\/\//.test(url)) erros.push('URL inválida em ' + k + ': ' + url);
  });

  if (erros.length) {
    throw new Error('Validação falhou:\n- ' + erros.join('\n- '));
  }

  Logger.log('Template validado com sucesso. CIDs e inlineImages: ' + imageKeys.join(', '));
  return true;
}

function enviarTestePerfumeEmOleoComposicao() {
  validarTemplatePerfumeEmOleoComposicao();

  var destinatario = Session.getActiveUser().getEmail();
  if (!destinatario) {
    throw new Error('Session.getActiveUser().getEmail() não retornou um endereço nesta execução.');
  }

  var subject = 'Seis composições, uma nova forma de sentir o perfume';
  var htmlBody = montarTemplatePerfumeEmOleoComposicao_();
  var inlineImages = obterInlineImagesPerfumeEmOleoComposicao_();
  var plainBody = montarTextoSimplesPerfumeEmOleoComposicao_();

  GmailApp.sendEmail(destinatario, subject, plainBody, {
    htmlBody: htmlBody,
    inlineImages: inlineImages,
    name: 'Essência do Brasil'
  });

  Logger.log('Teste enviado para: ' + destinatario);
}
