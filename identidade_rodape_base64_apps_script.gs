/**
 * IDENTIDADE / RODAPÉ — ÍCONES APROVADOS
 *
 * PNGs individuais com fundo transparente, incorporados em base64.
 * São exatamente os arquivos aprovados visualmente.
 */

function obterBlobsIdentidadeRodape() {
  const iconeFolhaMarca = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-folha-marca.png'
  );

  const logoEssencia = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'logo-essencia-do-brasil.png'
  );

  const iconeInstagram = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-instagram.png'
  );

  const iconeFacebook = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-facebook.png'
  );

  const iconeTikTok = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-tiktok.png'
  );

  const iconeWhatsApp = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-whatsapp.png'
  );

  const iconeTelefone = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-telefone.png'
  );

  const iconeEnvelope = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-envelope.png'
  );

  const iconeCadeado = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'icone-cadeado.png'
  );

  const ramoBotanico = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'ramo-botanico.png'
  );

  return {
    iconeFolhaMarca: iconeFolhaMarca,
    logoEssencia: logoEssencia,
    iconeInstagram: iconeInstagram,
    iconeFacebook: iconeFacebook,
    iconeTikTok: iconeTikTok,
    iconeWhatsApp: iconeWhatsApp,
    iconeTelefone: iconeTelefone,
    iconeEnvelope: iconeEnvelope,
    iconeCadeado: iconeCadeado,
    ramoBotanico: ramoBotanico
  };
}

function salvarIdentidadeRodapeNoDrive() {
  const itens = obterBlobsIdentidadeRodape();
  Object.keys(itens).forEach(function(chave) {
    DriveApp.createFile(itens[chave]);
  });
  Logger.log('Arquivos salvos no Google Drive com sucesso.');
}

function enviarTesteIdentidadeRodape() {
  const email = Session.getActiveUser().getEmail();
  if (!email) {
    throw new Error('Não foi possível detectar o e-mail da conta ativa.');
  }

  const itens = obterBlobsIdentidadeRodape();

  const html = `
  <div style="background:#ffffff;padding:28px;">
    <table role="presentation" cellspacing="0" cellpadding="20" border="0" style="border-collapse:collapse;margin:auto;">
      <tr>
        <td align="center"><img src="cid:folha" width="110" style="display:block;border:0;width:110px;height:auto;"></td>
        <td align="center"><img src="cid:logo" width="260" style="display:block;border:0;width:260px;height:auto;"></td>
      </tr>
      <tr>
        <td align="center"><img src="cid:instagram" width="85" style="display:block;border:0;width:85px;height:auto;"></td>
        <td align="center"><img src="cid:facebook" width="85" style="display:block;border:0;width:85px;height:auto;"></td>
      </tr>
      <tr>
        <td align="center"><img src="cid:tiktok" width="85" style="display:block;border:0;width:85px;height:auto;"></td>
        <td align="center"><img src="cid:whatsapp" width="85" style="display:block;border:0;width:85px;height:auto;"></td>
      </tr>
      <tr>
        <td align="center"><img src="cid:telefone" width="85" style="display:block;border:0;width:85px;height:auto;"></td>
        <td align="center"><img src="cid:envelope" width="85" style="display:block;border:0;width:85px;height:auto;"></td>
      </tr>
      <tr>
        <td align="center"><img src="cid:cadeado" width="85" style="display:block;border:0;width:85px;height:auto;"></td>
        <td align="center"><img src="cid:ramo" width="150" style="display:block;border:0;width:150px;height:auto;"></td>
      </tr>
    </table>
  </div>`;

  GmailApp.sendEmail(
    email,
    'Teste — identidade e rodapé',
    'Abra em um cliente com suporte a HTML.',
    {
      htmlBody: html,
      inlineImages: {
        folha: itens.iconeFolhaMarca,
        logo: itens.logoEssencia,
        instagram: itens.iconeInstagram,
        facebook: itens.iconeFacebook,
        tiktok: itens.iconeTikTok,
        whatsapp: itens.iconeWhatsApp,
        telefone: itens.iconeTelefone,
        envelope: itens.iconeEnvelope,
        cadeado: itens.iconeCadeado,
        ramo: itens.ramoBotanico
      },
      name: 'Essência do Brasil'
    }
  );

  Logger.log('E-mail de teste enviado para: ' + email);
}
