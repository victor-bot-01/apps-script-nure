function criarSpriteBlob_() {
  return Utilities.newBlob(Utilities.base64Decode(ICONE_SPRITE_BASE64), 'image/png', 'iconeSprite.png');
}

function enviarTesteIconesSprite() {
  const html = montarHtmlIconesSprite(DADOS_ICONES_SPRITE);
  GmailApp.sendEmail(EMAIL_DESTINO_ICONES_SPRITE, 'Teste - Template B (ícones em sprite)', 'Abra este e-mail num cliente que suporte HTML pra ver o conteúdo completo.', {
    htmlBody: html,
    inlineImages: { iconeSprite: criarSpriteBlob_() },
    name: 'Essência do Brasil',
  });
  Logger.log('Enviado para ' + EMAIL_DESTINO_ICONES_SPRITE);
}

// ======================= MONTAGEM DO HTML =======================

function montarHtmlIconesSprite(d) {
  const corCreme = '#f7f2e7';
  const corCremeClaro = '#faf7f0';
  const corVerdeEscuro = '#1c2a18';
  const corVerdeEscuro2 = '#16220f';
  const corDourado = '#c9a227';
  const corTextoClaro = '#f4ecdb';
  const corTextoEscuro = '#2a2823';
  const corTextoSuave = '#6f6a58';
  const corBordaSuave = '#e2d9c2';

  // Recorta um ícone da imagem única (sprite): a "janela" é um <div> do
  // tamanho exato do ícone com overflow:hidden; dentro, a imagem inteira
  // do sprite é escalada (a grade toda passa a medir 5x o tamanho pedido,
  // já que são 5 colunas/linhas) e deslocada com margin negativo até a
  // posição certa cair dentro da janela.
  const spriteIcone = function(nomeIcone, tamanho, comoBloco) {
    const pos = SPRITE_POSICOES[nomeIcone];
    const escala = tamanho / SPRITE_CELULA;
    const spriteTamanho = Math.round(SPRITE_CELULA * SPRITE_COLUNAS * escala);
    const deslocX = Math.round(pos.col * SPRITE_CELULA * escala);
    const deslocY = Math.round(pos.row * SPRITE_CELULA * escala);
    // O "margin:0 auto" de centralizar fica só na <div> de fora - nunca no
    // <img> de dentro, porque ali ele sobrescreveria o margin-left/
    // margin-top que faz o recorte do sprite (margin resumido reseta os
    // dois de uma vez, foi o bug que fazia todo ícone "em bloco" cair
    // sempre na posição 0,0 do sprite).
    return (
      '<div style="width:' + tamanho + 'px;height:' + tamanho + 'px;overflow:hidden;' +
        (comoBloco ? 'display:block;margin:0 auto;' : 'display:inline-block;vertical-align:middle;') + '">' +
        '<img src="cid:iconeSprite" width="' + spriteTamanho + '" height="' + spriteTamanho + '" alt="" style="display:block;width:' + spriteTamanho + 'px;height:' + spriteTamanho + 'px;margin-left:-' + deslocX + 'px;margin-top:-' + deslocY + 'px;border:0;">' +
      '</div>'
    );
  };

  const img = function(nomeIcone, tamanho) { return spriteIcone(nomeIcone, tamanho, false); };
  const imgBloco = function(nomeIcone, tamanho) { return spriteIcone(nomeIcone, tamanho, true); };

  const placeholderImagem = function(altura, textoDentro) {
