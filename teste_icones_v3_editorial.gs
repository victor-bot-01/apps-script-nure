const EMAIL_DESTINO = ''; // Ex.: 'seuemail@gmail.com'

function enviarTesteIconesV3() {
  const email = EMAIL_DESTINO || Session.getActiveUser().getEmail();

  if (!email) {
    throw new Error(
      'Preencha EMAIL_DESTINO no início do código com o e-mail de destino.'
    );
  }

  const perfume = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'perfume.png'
  );
  const leaf = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'leaf.png'
  );
  const heart = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'heart.png'
  );
  const cruelty = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'cruelty.png'
  );
  const gift = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'gift.png'
  );
  const truck = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'truck.png'
  );
  const card = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'card.png'
  );
  const lock = Utilities.newBlob(
    Utilities.base64Decode(''),
    'image/png',
    'lock.png'
  );

  const html = `
  <div style="margin:0;padding:0;background:#ffffff;">
    <table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0"
           style="margin:0 auto;background:#ffffff;border-collapse:collapse;">
        <tr>
          <td align="center" valign="middle" style="padding:44px 56px;">
            <img src="cid:perfume" width="180" height="180"
                 style="display:block;width:180px;height:180px;object-fit:contain;border:0;">
          </td>
          <td align="center" valign="middle" style="padding:44px 56px;">
            <img src="cid:leaf" width="180" height="180"
                 style="display:block;width:180px;height:180px;object-fit:contain;border:0;">
          </td>
        </tr>
        <tr>
          <td align="center" valign="middle" style="padding:44px 56px;">
            <img src="cid:heart" width="180" height="180"
                 style="display:block;width:180px;height:180px;object-fit:contain;border:0;">
          </td>
          <td align="center" valign="middle" style="padding:44px 56px;">
            <img src="cid:cruelty" width="180" height="180"
                 style="display:block;width:180px;height:180px;object-fit:contain;border:0;">
          </td>
        </tr>
        <tr>
          <td align="center" valign="middle" style="padding:44px 56px;">
            <img src="cid:gift" width="180" height="180"
                 style="display:block;width:180px;height:180px;object-fit:contain;border:0;">
          </td>
          <td align="center" valign="middle" style="padding:44px 56px;">
            <img src="cid:truck" width="180" height="180"
                 style="display:block;width:180px;height:180px;object-fit:contain;border:0;">
          </td>
        </tr>
        <tr>
          <td align="center" valign="middle" style="padding:44px 56px;">
            <img src="cid:card" width="180" height="180"
                 style="display:block;width:180px;height:180px;object-fit:contain;border:0;">
          </td>
          <td align="center" valign="middle" style="padding:44px 56px;">
            <img src="cid:lock" width="180" height="180"
                 style="display:block;width:180px;height:180px;object-fit:contain;border:0;">
          </td>
        </tr>
    </table>
  </div>`;

  GmailApp.sendEmail(
    email,
    'Teste visual — ícones V3',
    'Abra este e-mail em um cliente com suporte a HTML.',
    {
      htmlBody: html,
      inlineImages: {
        perfume: perfume,
        leaf: leaf,
        heart: heart,
        cruelty: cruelty,
        gift: gift,
        truck: truck,
        card: card,
        lock: lock
      },
      name: 'Teste de Ícones V3'
    }
  );

  Logger.log('Teste enviado para: ' + email);
}
